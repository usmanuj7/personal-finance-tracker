{\n  "name": "personal-finance-tracker-monorepo",\n  "version": "1.0.0",\n  "description": "Personal Finance Tracker - React and Vue implementations",\n  "private": true,\n  "scripts": {\n    "dev": "concurrently \"npm run server\" \"npm run dev:react\" \"npm run dev:vue\"",\n    "dev:react": "cd react-app && npm run dev",\n    "dev:vue": "cd vue-app && npm run dev",\n    "server": "json-server --watch api/db.json --port 3000",\n    "build": "npm run build:react && npm run build:vue",\n    "build:react": "cd react-app && npm run build",\n    "build:vue": "cd vue-app && npm run build"\n  },\n  "devDependencies": {\n    "concurrently": "^8.2.2",\n    "json-server": "^0.17.4"\n  }\n}\n